# DarkIntel — contenedor de API (redes: frontend + backend)
#
# Sirve los bundles STIX ya generados por el pipeline. No ejecuta el pipeline
# en vivo y no necesita el stack de ML: el unico codigo de darkintel que
# importa es el extractor regex (solo stdlib).
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/src

WORKDIR /app

COPY docker/requirements-api.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY src/ /app/src/
COPY api/ /app/api/

RUN useradd --create-home --uid 1000 apiuser \
    && mkdir -p /app/data/output \
    && chown -R apiuser:apiuser /app
USER apiuser

EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
