# DarkIntel — proxy Tor (redes: darknet + tor_egress)
#
# Daemon Tor en modo SOLO CLIENTE (sin relay ni nodo de salida). Expone
# únicamente SOCKS5 (:9050) dentro de la red darknet. Sin ControlPort: la
# rotación de circuitos se hace por credenciales SOCKS (IsolateSOCKSAuth).
FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends tor curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY docker/torrc /etc/tor/torrc

EXPOSE 9050
USER debian-tor
CMD ["tor", "-f", "/etc/tor/torrc"]
