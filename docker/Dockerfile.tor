# DarkIntel — proxy Tor (red: darknet)
#
# Recolecta las URLs de SCRAPER_TARGET_URL vía Tor (ver SAFE_TESTING.md).
FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends tor curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY docker/torrc /etc/tor/torrc
COPY docker/tor-entrypoint.sh /usr/local/bin/tor-entrypoint.sh
# Windows guarda los archivos con CRLF; un script con \r no arranca en Linux.
RUN sed -i 's/\r$//' /usr/local/bin/tor-entrypoint.sh \
    && chmod 755 /usr/local/bin/tor-entrypoint.sh

EXPOSE 9050
USER debian-tor
CMD ["/usr/local/bin/tor-entrypoint.sh"]
