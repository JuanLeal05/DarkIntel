# Copiar a .env antes de levantar el stack:  cp .env.example .env
# .env esta en .gitignore — nunca subir credenciales reales al repositorio.

POSTGRES_USER=darkintel
POSTGRES_PASSWORD=cambiar_esta_password
POSTGRES_DB=darkintel

# Puerto publicado de la API en el host.
API_PORT=8000

# Contraseña en texto plano del ControlPort de Tor (stem la usa para pedir
# NEWNYM). Debe coincidir con el hash puesto en docker/torrc — regenerar con:
#   docker compose run --rm tor-proxy tor --hash-password "tu_password_aqui"
TOR_CONTROL_PASSWORD=cambia_esta_password_de_control

# Objetivo del scraper. Controla en qué etapa de SAFE_TESTING.md estás:
#   Etapa 1 (default): http://test-onion:80            -> hidden service propio
#   Etapa 2: la .onion de check.torproject.org u otro servicio legítimo conocido
#   Etapa 3: la .onion real objeto de la investigación
SCRAPER_TARGET_URL=http://test-onion:80
