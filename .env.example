# Copiar a .env antes de levantar el stack:  cp .env.example .env
# .env esta en .gitignore — nunca subir credenciales reales al repositorio.

POSTGRES_USER=darkintel
POSTGRES_PASSWORD=
POSTGRES_DB=darkintel

# Puerto publicado de la API en el host.
API_PORT=8000

# Contraseña en texto plano del ControlPort de Tor (stem la usa para pedir
# NEWNYM). Debe coincidir con el hash puesto en docker/torrc — regenerar con:
#   docker compose run --rm tor-proxy tor --hash-password "tu_password_aqui"
TOR_CONTROL_PASSWORD=

# Objetivo(s) del scraper. Acepta varias URLs separadas por coma.
# Controla en qué etapa de SAFE_TESTING.md estás:
#   Etapa 1: la direccion .onion que GENERA el contenedor test-onion
#   Etapa 2: la .onion de check.torproject.org u otro servicio legítimo conocido
#   Etapa 3: la .onion real objeto de la investigación
#
# OJO: aquí NO sirve "http://test-onion:80". Ese es un nombre DNS de Docker y
# socks5h se lo entrega a Tor para que lo resuelva; Tor no sabe qué es y
# responde "0x04 Host unreachable". Tiene que ser la direccion .onion real,
# que se lee del propio contenedor:
#
#   docker compose exec -T test-onion cat /var/lib/tor/test_service/hostname
#
# Gracias al volumen testonion_data esa direccion ya no cambia entre
# reinicios, así que basta con leerla una vez y pegarla aquí.
SCRAPER_TARGET_URL=
